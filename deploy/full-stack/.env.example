# 이 파일을 .env로 복사한 뒤 값을 채우세요: cp .env.example .env

# 접속 토큰 (필수)
REMOTE_TOKEN=change-me-strong-token

# 제어 대상 리눅스 데스크톱의 DISPLAY (보통 :0)
DISPLAY=:0

# X 인증 파일 경로 (보통 자동 설정됨. 비어있으면 compose가 $HOME/.Xauthority 사용)
# XAUTHORITY=/home/youruser/.Xauthority

# --- TURN (선택) ---
# coturn을 --profile turn 으로 함께 띄우거나 외부 TURN을 쓸 때 채웁니다.
TURN_URL=

# 방식 A: 고정 계정
TURN_USER=
TURN_PASS=

# 방식 B(권장): 시간제한 자격증명 자동 발급.
# coturn turnserver.conf 의 static-auth-secret 과 동일한 값을 넣으면
# server.py 가 접속 시점마다 임시 자격증명을 발급합니다. (TURN_USER/PASS 불필요)
TURN_SECRET=
TURN_TTL=3600
